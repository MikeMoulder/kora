# ── Pollar ───────────────────────────────────────────────────────────────
# dashboard.pollar.xyz → Build → API Keys → Generate → publishable, testnet
NEXT_PUBLIC_POLLAR_PUBLISHABLE_KEY=pub_testnet_xxxxxxxxxxxxxxxxxxxx

# Backend only. Never prefix this with NEXT_PUBLIC_.
POLLAR_SECRET_KEY=sec_testnet_xxxxxxxxxxxxxxxxxxxx

NEXT_PUBLIC_STELLAR_NETWORK=testnet

# ── Settlement (the Bolivia hand-off target) ─────────────────────────────
# Run `npm run setup:settlement` to create and fund this automatically.
NEXT_PUBLIC_SETTLEMENT_ADDRESS=
SETTLEMENT_SECRET=

# USDC (default) or XLM. Use XLM only if you cannot get testnet USDC —
# the UI names whichever asset actually moves.
NEXT_PUBLIC_SETTLEMENT_ASSET=USDC

# ── Flutterwave (the Nigerian collections leg) ───────────────────────────
# flutterwave.com -> Settings -> API Keys, under DEVELOPERS.
# Test keys carry _TEST. Without these the NIP corridor falls back to its
# fixed sandbox account and says so on the funding screen.
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
NEXT_PUBLIC_FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxx-X

# Any random string. Set the same value on the dashboard under Settings ->
# Webhooks, where Flutterwave sends it back in the verif-hash header.
FLW_SECRET_HASH=

# Placeholder BVN for the personal deposit account in test mode. A permanent
# Nigerian account number is tied to a verified identity, so Flutterwave
# requires one. Only ever sent against test keys; live keys with no real BVN
# are refused rather than sent a made up one. Eleven digits, despite the ten
# digit example in Flutterwave's own docs.
FLW_TEST_BVN=12345678901

# ── Intent parsing ───────────────────────────────────────────────────────
# Optional. Without it the deterministic parser runs alone and the UI says so.
# aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
