# ── Pollar ───────────────────────────────────────────────────────────────
# dashboard.pollar.xyz → Build → API Keys → Generate → publishable, testnet
NEXT_PUBLIC_POLLAR_PUBLISHABLE_KEY=pub_testnet_xxxxxxxxxxxxxxxxxxxx

# Backend only. Never prefix this with NEXT_PUBLIC_.
POLLAR_SECRET_KEY=sec_testnet_xxxxxxxxxxxxxxxxxxxx

NEXT_PUBLIC_STELLAR_NETWORK=testnet

# ── Settlement (the Bolivia hand-off target) ─────────────────────────────
# Run `npm run setup:settlement` to create and fund this automatically.
NEXT_PUBLIC_SETTLEMENT_ADDRESS=
SETTLEMENT_SECRET=

# USDC (default) or XLM. Use XLM only if you cannot get testnet USDC —
# the UI names whichever asset actually moves.
NEXT_PUBLIC_SETTLEMENT_ASSET=USDC

# ── Intent parsing ───────────────────────────────────────────────────────
# Optional. Without it the deterministic parser runs alone and the UI says so.
# aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
